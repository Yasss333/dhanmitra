# Setu Bridge Sandbox → Organization settings → OAuth keys
SETU_ENVIRONMENT=sandbox
SETU_CLIENT_ID=replace_with_sandbox_client_id
SETU_CLIENT_SECRET=replace_with_sandbox_secret
# This is the Merchant ID / Product Instance ID from your Setu Bridge UPI Deep Links config.
SETU_PRODUCT_INSTANCE_ID=replace_with_sandbox_product_instance_id

# Razorpay Test Mode (no KYC needed for test keys)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=replace_with_test_secret

# Vapi (Voice AI — STT + TTS layer)
VAPI_PRIVATE_KEY=replace_with_vapi_private_key
VAPI_ASSISTANT_ID=replace_with_vapi_assistant_id

# Existing app configuration
MONGODB_URI=mongodb://localhost:27017
DB_NAME=Dhan-mitra-proto
FRONTEND_URL=http://localhost:5173
OPENROUTER_API_KEY=replace_with_openrouter_key
TELEGRAM_BOT_TOKEN=replace_with_bot_token
# Public HTTPS URL ending in /api/webhook/telegram
TELEGRAM_WEBHOOK_URL=https://your-public-host/api/webhook/telegram
# Optional Telegram webhook secret token
TELEGRAM_WEBHOOK_SECRET=replace_with_webhook_secret
